# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# your values. ".env" is ignored by git — never commit real keys.

# PandaScore API key — get one free at https://pandascore.co (required for PS widgets)
PANDASCORE_TOKEN=

# Twitch account (optional). Value of the "auth-token" cookie:
# twitch.tv (logged in) → F12 → Application → Cookies → https://www.twitch.tv → auth-token
# Enables ad-free playback on subscribed channels/Turbo and the followed-live list.
# Logging out of Twitch in that browser invalidates it — re-copy if it stops working.
TWITCH_AUTH_TOKEN=
